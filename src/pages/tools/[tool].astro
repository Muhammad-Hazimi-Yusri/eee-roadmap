---
// src/pages/tools/[tool].astro — individual tool page.
// Picks the right body component based on `tool.runtime`.

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RecipeCodeBlock from '../../components/toolkit/RecipeCodeBlock.astro';
import SnippetView from '../../components/tools/SnippetView.astro';
import JsToolView from '../../components/tools/JsToolView';
import PythonToolView from '../../components/tools/PythonToolView';
import { internalHref } from '../../utils/url';
import type { Tool } from '../../lib/tools/types';

export async function getStaticPaths() {
  const modules = import.meta.glob<Tool>('../../data/tools/*.json', { eager: true });
  return Object.values(modules).map(t => ({
    params: { tool: t.id },
    props: { tool: t },
  }));
}

interface Props { tool: Tool }
const { tool } = Astro.props;

const runtimeLabel: Record<string, string> = {
  js: 'browser',
  python: 'python · pyodide',
  snippet: 'copy-paste',
};
---

<Layout title={tool.title} description={tool.description}>
  <Header />
  <main id="main-content">
    <div class="container py-16">

      <nav class="lesson-breadcrumb" aria-label="Breadcrumb">
        <a href={internalHref('tools')}>Tools</a>
        <span aria-hidden="true"> / </span>
        <span>{tool.title}</span>
      </nav>

      <div class="tool-header">
        <div class="tool-header__meta">
          <span class={`badge badge--${tool.difficulty}`}>{tool.difficulty}</span>
          <span class={`badge badge--runtime badge--runtime-${tool.runtime}`}>
            {runtimeLabel[tool.runtime]}
          </span>
          <span class="badge badge--cat">{tool.category}</span>
        </div>
        <h1 class="tool-title">{tool.title}</h1>
        <p class="tool-desc">{tool.description}</p>
      </div>

      <section class="tool-body">
        {tool.runtime === 'js' && <JsToolView componentKey={tool.componentKey} client:visible />}
        {tool.runtime === 'python' && <PythonToolView tool={tool} client:visible />}
        {tool.runtime === 'snippet' && <SnippetView tool={tool} />}
      </section>

      {tool.runtime !== 'snippet' && tool.blocks && tool.blocks.length > 0 && (
        <section class="tool-notes">
          {tool.blocks.map(block => {
            if (block.type === 'prose') return <p class="tool-prose">{block.text}</p>;
            if (block.type === 'note') {
              const kind = block.kind ?? 'tip';
              return (
                <aside class={`tool-note tool-note--${kind}`}>
                  <span class="tool-note__label">{kind}</span>
                  <span>{block.text}</span>
                </aside>
              );
            }
            return <RecipeCodeBlock language={block.language} filename={block.filename} text={block.text} />;
          })}
        </section>
      )}

      {tool.relatedLabs && tool.relatedLabs.length > 0 && (
        <div class="related-concepts">
          <span class="related-concepts__label">Related labs:</span>
          {tool.relatedLabs.map(rl => (
            <a href={internalHref(`learn/power-systems/${rl.id}`)} class="related-concepts__link">
              {rl.label}
            </a>
          ))}
        </div>
      )}

      <div class="tool-footer-nav">
        <a href={internalHref('tools')} class="btn">← All tools</a>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .lesson-breadcrumb {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .lesson-breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .lesson-breadcrumb a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .tool-header { margin-bottom: 1.75rem; }

  .tool-header__meta {
    display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  .badge--beginner     { background: color-mix(in srgb, var(--color-pcb) 15%, transparent); color: var(--color-pcb-light); }
  .badge--intermediate { background: color-mix(in srgb, var(--color-copper) 15%, transparent); color: var(--color-copper); }
  .badge--advanced     { background: color-mix(in srgb, #2563eb 15%, transparent); color: #60a5fa; }
  .badge--cat          { background: var(--color-bg-grid); color: var(--color-text-muted); border: 1px solid var(--color-border); }

  .badge--runtime-js      { background: rgb(37 99 235 / 8%); color: #2563eb; border: 1px solid rgb(37 99 235 / 35%); }
  .badge--runtime-python  { background: rgb(22 163 74 / 8%); color: #16a34a; border: 1px solid rgb(22 163 74 / 35%); }
  .badge--runtime-snippet { background: var(--color-bg-grid); color: var(--color-text-muted); border: 1px solid var(--color-border); }

  .tool-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .tool-desc {
    color: var(--color-text-muted);
    max-width: 64ch;
    line-height: 1.6;
    margin: 0;
  }

  .tool-body {
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    margin-bottom: 1.5rem;
  }

  .tool-notes {
    max-width: 80ch;
    line-height: 1.65;
  }

  .tool-prose {
    font-size: 0.9rem;
    color: var(--color-text);
    margin: 0 0 0.85rem;
  }

  .tool-note {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    border-radius: 4px;
    border-left: 3px solid;
    margin: 0.6rem 0 1rem;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .tool-note__label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    flex-shrink: 0;
    margin-top: 0.18rem;
    padding: 0.05rem 0.45rem;
    border-radius: 2px;
  }

  .tool-note--tip {
    background: rgb(34 197 94 / 6%);
    border-color: #22c55e;
  }

  .tool-note--tip .tool-note__label {
    background: rgb(34 197 94 / 18%); color: #22c55e;
  }

  .tool-note--warn {
    background: rgb(249 115 22 / 6%);
    border-color: #f97316;
  }

  .tool-note--warn .tool-note__label {
    background: rgb(249 115 22 / 18%); color: #f97316;
  }

  .tool-note--gotcha {
    background: rgb(239 68 68 / 5%);
    border-color: #ef4444;
  }

  .tool-note--gotcha .tool-note__label {
    background: rgb(239 68 68 / 16%); color: #ef4444;
  }

  .related-concepts {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
  }

  .related-concepts__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .related-concepts__link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-copper, #c87533);
    border-radius: 3px;
    color: var(--color-copper, #c87533);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .related-concepts__link:hover {
    background: var(--color-copper, #c87533);
    color: #fff;
  }

  .tool-footer-nav { margin-top: 2.5rem; }
</style>
